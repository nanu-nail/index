rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function servicePath(serviceId) {
      return /databases/$(database)/documents/services/$(serviceId);
    }

    function bookingSettingsPath() {
      return /databases/$(database)/documents/businessSettings/booking;
    }

    function blockedDatePath(date) {
      let dateId = string(date.toMillis());
      return /databases/$(database)/documents/blockedDates/$(dateId);
    }

    function bookingCapacityPath(date) {
      let dateId = string(date.toMillis());
      return /databases/$(database)/documents/bookingCapacityOverrides/$(dateId);
    }

    function dailyBookingCapacity(date) {
      let path = bookingCapacityPath(date);
      return exists(path) ? get(path).data.capacity : 2;
    }

    function closurePath(date) {
      let dateId = string(date.toMillis());
      return /databases/$(database)/documents/bookingClosures/$(dateId);
    }

    function outsideClosureRange(ranges, index, start, end) {
      return ranges.size() <= index
        || end <= ranges[index].startMinute || start >= ranges[index].endMinute;
    }

    function outsideClosures(data) {
      let path = closurePath(data.date);
      let ranges = exists(path) ? get(path).data.ranges : [];
      let start = data.startHour * 60;
      let end = start + data.durationMinutes;
      return outsideClosureRange(ranges, 0, start, end)
        && outsideClosureRange(ranges, 1, start, end)
        && outsideClosureRange(ranges, 2, start, end)
        && outsideClosureRange(ranges, 3, start, end)
        && outsideClosureRange(ranges, 4, start, end)
        && outsideClosureRange(ranges, 5, start, end)
        && outsideClosureRange(ranges, 6, start, end)
        && outsideClosureRange(ranges, 7, start, end);
    }

    function validClosureRange(ranges, index) {
      return ranges.size() <= index || (
        ranges[index] is map
        && ranges[index].keys().hasOnly(['startMinute', 'endMinute'])
        && ranges[index].keys().hasAll(['startMinute', 'endMinute'])
        && ranges[index].startMinute is int && ranges[index].endMinute is int
        && ranges[index].startMinute >= 0 && ranges[index].endMinute <= 1440
        && ranges[index].startMinute < ranges[index].endMinute);
    }

    function withinConfiguredHours(data) {
      let localMidnight = data.date + duration.value(8, 'h');
      let settings = get(bookingSettingsPath()).data;
      return exists(bookingSettingsPath())
        && data.date is timestamp
        && data.startAt is timestamp
        && data.endAt is timestamp
        && localMidnight.hours() == 0
        && localMidnight.minutes() == 0
        && localMidnight.seconds() == 0
        && data.startAt == data.date + duration.value(data.startHour, 'h')
        && data.startAt > request.time
        && data.endAt == data.startAt + duration.value(data.durationMinutes, 'm')
        && data.startHour >= settings.openHour
        && data.startHour < settings.closeHour
        && data.startHour * 60 + data.durationMinutes <= settings.closeHour * 60
        && outsideClosures(data)
        && (!settings.keys().hasAny(['openMonths']) || settings.openMonths.hasAny([localMidnight.year() * 100 + localMidnight.month()]))
        && (!exists(blockedDatePath(data.date)) || get(blockedDatePath(data.date)).data.active != true);
    }

    function scheduleDayPath(staffId, date) {
      let localDate = date + duration.value(8, 'h');
      return /databases/$(database)/documents/scheduleDays/$(staffId)/years/$(localDate.year())/months/$(localDate.month())/days/$(localDate.day());
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function validServiceSnapshot(data) {
      return exists(servicePath(data.serviceId))
        && get(servicePath(data.serviceId)).data.active == true
        && get(servicePath(data.serviceId)).data.name == data.serviceName
        && get(servicePath(data.serviceId)).data.price == data.price
        && get(servicePath(data.serviceId)).data.durationMinutes == data.serviceDurationMinutes
        && data.durationMinutes == data.serviceDurationMinutes + data.addOnDurationMinutes
        && (!data.keys().hasAny(['selectedAddOns'])
          || (data.selectedAddOns is list
            && get(servicePath(data.serviceId)).data.addOns is list
            && data.selectedAddOns.size() <= get(servicePath(data.serviceId)).data.addOns.size() * 10
            && get(servicePath(data.serviceId)).data.addOns.hasAll(data.selectedAddOns)));
    }

    function validBookingShape(data) {
      return data.keys().hasAll([
          'userId', 'customerName', 'customerEmail', 'staffId', 'date', 'startAt', 'endAt', 'startHour',
          'serviceId', 'serviceName', 'price', 'durationMinutes', 'serviceDurationMinutes', 'addOnDurationMinutes', 'designCategory',
          'designWorkTitle', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'customerName', 'customerEmail', 'customerPhone', 'staffId', 'date', 'startAt', 'endAt', 'startHour',
          'serviceId', 'serviceName', 'price', 'durationMinutes', 'serviceDurationMinutes', 'addOnDurationMinutes', 'designCategory',
          'designWorkTitle', 'status', 'createdAt', 'updatedAt', 'confirmedAt', 'cancelledAt', 'selectedAddOns'
        ])
        && data.staffId == 'primary'
        && data.date is timestamp
        && data.startHour is int
        && data.startHour >= 0 && data.startHour < 24
        && data.serviceId is string
        && data.serviceName is string
        && data.price is number && data.price >= 0
        && data.durationMinutes is int && data.durationMinutes > 0
        && data.serviceDurationMinutes is int && data.serviceDurationMinutes > 0
        && data.addOnDurationMinutes is int && data.addOnDurationMinutes >= 0
        && data.designCategory is string
        && data.designWorkTitle is string
        && (!data.keys().hasAny(['selectedAddOns']) || data.selectedAddOns is list)
        && (!data.keys().hasAny(['customerPhone']) || data.customerPhone is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function pairedScheduleBooking(bookingId, staffId, date, hour, userId, action) {
      let path = bookingPath(bookingId);
      return existsAfter(path)
        && getAfter(path).data.userId == userId
        && getAfter(path).data.staffId == staffId
        && getAfter(path).data.date == date
        && getAfter(path).data.startHour == hour
        && (action == 'cancel' || withinConfiguredHours(getAfter(path).data))
        && (action == 'book' ? getAfter(path).data.status == 'pending' : getAfter(path).data.status == 'cancelled');
    }

    function scheduleDayShape(data) {
      return data.keys().hasAll([
          'staffId', 'date', 'startHours', 'lastAction', 'lastBookingId',
          'lastStartHour', 'lastUserId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffId', 'date', 'startHours', 'endMinutesByStart', 'lastAction', 'lastBookingId',
          'lastStartHour', 'lastUserId', 'updatedAt'
        ])
        && data.staffId == 'primary'
        && data.date is timestamp
        && data.startHours is list
        && (!data.keys().hasAny(['endMinutesByStart']) || data.endMinutesByStart is map)
        && data.lastAction in ['book', 'cancel']
        && data.lastBookingId is string
        && data.lastStartHour is int
        && data.lastUserId is string
        && data.updatedAt is timestamp;
    }

    function noExistingNearbyStart(hour) {
      return !resource.data.startHours.hasAny([
        hour - 3, hour - 2, hour - 1, hour + 1, hour + 2, hour + 3
      ]);
    }

    function validBookingEnd(data, previousEnds) {
      let key = string(data.lastStartHour);
      let booking = getAfter(bookingPath(data.lastBookingId)).data;
      return data.endMinutesByStart is map
        && data.endMinutesByStart[key] == data.lastStartHour * 60 + booking.durationMinutes
        && data.endMinutesByStart.diff(previousEnds).affectedKeys().hasOnly([key]);
    }

    function outsideExistingBooking(hour, start, end, ends) {
      return !resource.data.startHours.hasAny([hour])
        || end <= hour * 60 || start >= ends.get(string(hour), (hour + 4) * 60);
    }

    function noBookingOverlap(data) {
      let start = data.lastStartHour * 60;
      let end = start + getAfter(bookingPath(data.lastBookingId)).data.durationMinutes;
      let ends = resource.data.get('endMinutesByStart', {});
      return outsideExistingBooking(0, start, end, ends)
        && outsideExistingBooking(1, start, end, ends)
        && outsideExistingBooking(2, start, end, ends)
        && outsideExistingBooking(3, start, end, ends)
        && outsideExistingBooking(4, start, end, ends)
        && outsideExistingBooking(5, start, end, ends)
        && outsideExistingBooking(6, start, end, ends)
        && outsideExistingBooking(7, start, end, ends)
        && outsideExistingBooking(8, start, end, ends)
        && outsideExistingBooking(9, start, end, ends)
        && outsideExistingBooking(10, start, end, ends)
        && outsideExistingBooking(11, start, end, ends)
        && outsideExistingBooking(12, start, end, ends)
        && outsideExistingBooking(13, start, end, ends)
        && outsideExistingBooking(14, start, end, ends)
        && outsideExistingBooking(15, start, end, ends)
        && outsideExistingBooking(16, start, end, ends)
        && outsideExistingBooking(17, start, end, ends)
        && outsideExistingBooking(18, start, end, ends)
        && outsideExistingBooking(19, start, end, ends)
        && outsideExistingBooking(20, start, end, ends)
        && outsideExistingBooking(21, start, end, ends)
        && outsideExistingBooking(22, start, end, ends)
        && outsideExistingBooking(23, start, end, ends);
    }

    function bookingMatchesScheduleAfter(bookingId, data) {
      let path = scheduleDayPath(data.staffId, data.date);
      return existsAfter(path)
        && getAfter(path).data.lastAction == 'book'
        && getAfter(path).data.lastBookingId == bookingId
        && getAfter(path).data.lastStartHour == data.startHour
        && getAfter(path).data.lastUserId == request.auth.uid
        && getAfter(path).data.startHours.hasAny([data.startHour]);
    }

    function bookIntoScheduleDay() {
      let data = request.resource.data;
      return signedIn()
        && scheduleDayShape(data)
        && data.lastAction == 'book'
        && data.lastUserId == request.auth.uid
        && data.lastStartHour >= 0 && data.lastStartHour < 24
        && data.startHours.size() == 1
        && data.startHours.size() <= dailyBookingCapacity(data.date)
        && data.startHours.hasAny([data.lastStartHour])
        && validBookingEnd(data, {})
        && pairedScheduleBooking(data.lastBookingId, data.staffId, data.date, data.lastStartHour, request.auth.uid, 'book');
    }

    function addBookingToScheduleDay() {
      let data = request.resource.data;
      let hour = data.lastStartHour;
      return signedIn()
        && scheduleDayShape(data)
        && data.lastAction == 'book'
        && data.lastUserId == request.auth.uid
        && hour >= 0 && hour < 24
        && request.resource.data.startHours.size() == resource.data.startHours.size() + 1
        && request.resource.data.startHours.size() <= dailyBookingCapacity(data.date)
        && request.resource.data.startHours.hasAll(resource.data.startHours)
        && !resource.data.startHours.hasAny([hour])
        && noExistingNearbyStart(hour)
        && validBookingEnd(data, resource.data.get('endMinutesByStart', {}))
        && noBookingOverlap(data)
        && pairedScheduleBooking(data.lastBookingId, data.staffId, data.date, hour, request.auth.uid, 'book')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'startHours', 'endMinutesByStart', 'lastAction', 'lastBookingId', 'lastStartHour', 'lastUserId', 'updatedAt'
        ]);
    }

    function cancelFromScheduleDay() {
      let data = request.resource.data;
      let hour = data.lastStartHour;
      return isAdmin()
        && scheduleDayShape(data)
        && data.lastAction == 'cancel'
        && hour >= 0 && hour < 24
        && resource.data.startHours.hasAny([hour])
        && request.resource.data.startHours.size() == resource.data.startHours.size() - 1
        && !request.resource.data.startHours.hasAny([hour])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'startHours', 'endMinutesByStart', 'lastAction', 'lastBookingId', 'lastStartHour', 'lastUserId', 'updatedAt'
        ])
        && pairedScheduleBooking(data.lastBookingId, data.staffId, data.date, hour, data.lastUserId, 'cancel');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'customerName', 'phone', 'photoURL', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^09[0-9]{8}$');
      allow update: if signedIn()
        && request.auth.uid == userId
        && !('customerName' in resource.data)
        && !('phone' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'phone', 'photoURL', 'email', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'customerName', 'phone', 'photoURL', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^09[0-9]{8}$');
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /portfolios/{workId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedDates/{blockedDateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookingCapacityOverrides/{capacityId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'capacity', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'capacity', 'updatedAt'])
        && request.resource.data.date is string
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 20
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /bookingClosures/{closureId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'ranges', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'ranges', 'updatedAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.ranges is list
        && request.resource.data.ranges.size() >= 1 && request.resource.data.ranges.size() <= 8
        && validClosureRange(request.resource.data.ranges, 0)
        && validClosureRange(request.resource.data.ranges, 1)
        && validClosureRange(request.resource.data.ranges, 2)
        && validClosureRange(request.resource.data.ranges, 3)
        && validClosureRange(request.resource.data.ranges, 4)
        && validClosureRange(request.resource.data.ranges, 5)
        && validClosureRange(request.resource.data.ranges, 6)
        && validClosureRange(request.resource.data.ranges, 7);
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{path=**}/days/{dayId} {
      allow read: if resource.data.staffId == 'primary';
    }

    match /scheduleDays/{staffId}/years/{year}/months/{month}/days/{day} {
      allow read: if true;
      allow create: if bookIntoScheduleDay() || isAdmin();
      allow update: if addBookingToScheduleDay() || cancelFromScheduleDay() || isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validBookingShape(request.resource.data)
        && withinConfiguredHours(request.resource.data)
        && validServiceSnapshot(request.resource.data)
        && bookingMatchesScheduleAfter(bookingId, request.resource.data);
      allow update: if isAdmin() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'confirmedAt', 'cancelledAt'
          ])
          && request.resource.data.status in ['confirmed', 'cancelled', 'completed']
          && ((resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'cancelled'])
            || (resource.data.status == 'confirmed' && request.resource.data.status in ['cancelled', 'completed']))
          && (request.resource.data.status != 'cancelled'
            || !getAfter(scheduleDayPath(resource.data.staffId, resource.data.date)).data.startHours.hasAny([resource.data.startHour]))
        )
        || (
          resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPrice', 'updatedAt'])
          && request.resource.data.totalPrice is number
          && request.resource.data.totalPrice >= 0
        )
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
